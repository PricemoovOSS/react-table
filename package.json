  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json && npm run build:scss",
    "build:scss": "sass --no-source-map src/style/index.scss dist/style/index.css",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:generate-output": "jest --json --outputFile=jest-test-results.json --passWithNoTests || true",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:css",
    "lint:eslint": "eslint --cache --ext .js,.jsx,.ts,.tsx ./",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:prettier": "prettier --check \"src/**/*.{css,html,js,json,md,mdx,scss,ts,tsx}\"",
    "format": "npm run format:prettier && npm run format:eslint",
    "format:eslint": "eslint --cache --ext .js,.jsx,.ts,.tsx --fix ./",
    "format:prettier": "prettier --write \"./**/*.{css,html,js,json,md,mdx,scss,ts,tsx}\"",
    "storybook": "storybook dev -p 9001",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "table",
    "virtualized",
    "virtualization",
    "data-grid",
    "performance"
